{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node hooks/agent-memory/cursor.mjs",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "node hooks/agent-memory/cursor.mjs",
        "timeout": 5
      }
    ],
    "subagentStart": [
      {
        "command": "node hooks/agent-memory/cursor.mjs",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "node hooks/agent-memory/cursor.mjs",
        "timeout": 5
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node hooks/agent-memory/cursor.mjs",
        "timeout": 5
      }
    ],
    "subagentStop": [
      {
        "command": "node hooks/agent-memory/cursor.mjs",
        "timeout": 5
      }
    ]
  }
}
