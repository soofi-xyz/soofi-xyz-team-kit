{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prismteam.ai/schemas/enact/agent-definition.schema.json",
  "title": "Enact agent definition",
  "description": "One version of an agent, packaged from its directory: the manifest from agent.json and the text of every other file. docs/agent-contract.md describes each field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "files"],
  "properties": {
    "manifest": { "$ref": "#/$defs/manifest" },
    "files": { "$ref": "#/$defs/files" }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "version": {
      "description": "Semantic version without build metadata. Immutable once saved.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "repository": {
      "description": "A GitHub repository as owner/name, in lowercase. The name cannot be . or .., which GitHub forbids.",
      "type": "string",
      "maxLength": 140,
      "pattern": "^[a-z0-9][a-z0-9-]{0,38}/([a-z0-9_-][a-z0-9._-]{0,99}|\\.[a-z0-9_-][a-z0-9._-]{0,98}|\\.\\.[a-z0-9._-]{1,98})$"
    },
    "permissions": {
      "description": "What a repository's token allows.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contents", "pull_requests"],
      "properties": {
        "contents": { "enum": ["read", "write"] },
        "pull_requests": { "enum": ["none", "read", "write"] }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "description",
        "model",
        "limits",
        "channels",
        "repositories",
        "hosts"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "version": { "$ref": "#/$defs/version" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "model": {
          "description": "The model family; the run chooses the credential and the concrete model.",
          "enum": ["opus", "sonnet", "haiku"]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_turns", "max_cost_usd"],
          "properties": {
            "max_turns": { "type": "integer", "minimum": 1, "maximum": 500 },
            "max_cost_usd": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
          }
        },
        "channels": {
          "description": "Entrances that may start a run: direct (the API and the MCP endpoint) and asana.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["direct", "asana"] }
        },
        "repositories": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "permissions"],
            "properties": {
              "name": { "$ref": "#/$defs/repository" },
              "permissions": { "$ref": "#/$defs/permissions" }
            }
          }
        },
        "run_repositories": {
          "description": "Lets each run name up to max more repositories, each on the environment's allowed list, all with these permissions. Without it a run names none.",
          "type": "object",
          "additionalProperties": false,
          "required": ["max", "permissions"],
          "properties": {
            "max": { "type": "integer", "minimum": 1, "maximum": 20 },
            "permissions": { "$ref": "#/$defs/permissions" }
          }
        },
        "tools": {
          "description": "Built-in tools the sandbox gives the agent beyond Claude Code's own: browser (a Chromium in Amazon Bedrock AgentCore Browser through Playwright's MCP tools).",
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "enum": ["browser"] }
        },
        "asana": {
          "description": "Gives the agent the asana tools, which call Asana as Enact's bot user. They reach only these projects, their tasks and those tasks' subtasks.",
          "type": "object",
          "additionalProperties": false,
          "required": ["projects"],
          "properties": {
            "projects": {
              "description": "Asana project gids.",
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[0-9]{1,32}$" }
            }
          }
        },
        "hosts": {
          "description": "Hosts a run may connect to, beyond what every run needs.",
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          }
        }
      }
    },
    "files": {
      "description": "Every file of the agent directory except agent.json, by path, as UTF-8 text.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 200,
      "propertyNames": {
        "pattern": "^(instructions\\.md|tools/[a-z][a-z0-9-]{0,62}\\.ts|subagents/[a-z][a-z0-9-]{0,62}\\.md|skills/[a-z][a-z0-9-]{0,62}/([A-Za-z0-9_][A-Za-z0-9._-]{0,99}/){0,8}[A-Za-z0-9_][A-Za-z0-9._-]{0,99})$"
      },
      "additionalProperties": { "type": "string", "maxLength": 262144 }
    }
  }
}
