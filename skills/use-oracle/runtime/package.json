{
  "name": "@soofi-xyz-team-kit/oracle-runtime",
  "version": "0.9.0",
  "private": true,
  "description": "Self-contained Elephant county-ingestion runtime bundled with the soofi-xyz-team-kit plugin: Restate-tracked pipeline services, file-based reconciliation, enrichment, and county-neutral roof-age estimation.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "elephant-county": "bin/elephant-county.mjs",
    "permit-backfill": "bin/permit-backfill.mjs",
    "permit-source-coverage": "bin/permit-source-coverage.mjs",
    "probe-broward-permits": "bin/probe-broward-permits.mjs",
    "reconcile-county": "bin/reconcile-county.mjs",
    "roof-age-backfill": "bin/roof-age-backfill.mjs"
  },
  "scripts": {
    "test": "npm run services:typecheck && vitest run && npm run test:transforms",
    "test:watch": "vitest",
    "test:transforms": "node scripts/run-transform-tests.mjs",
    "test:roof-age": "vitest run tests/roof-age-*.test.ts",
    "roof-age:typecheck": "tsc -p tsconfig.roof-age.json",
    "roof-age:audit": "node bin/roof-age-backfill.mjs",
    "roof-age:backfill": "node bin/roof-age-backfill.mjs",
    "permits:backfill": "node bin/permit-backfill.mjs",
    "permits:backfill-plan": "node bin/permit-backfill.mjs",
    "permits:coverage": "node bin/permit-source-coverage.mjs",
    "permits:probe-broward": "node bin/probe-broward-permits.mjs",
    "batch:build": "tsc -p tsconfig.batch.json",
    "batch:typecheck": "tsc -p tsconfig.batch.json --noEmit",
    "batch:plan": "tsx bin/enrichment-batch.ts plan",
    "batch:submit": "tsx bin/enrichment-batch.ts submit",
    "batch:status": "tsx bin/enrichment-batch.ts status",
    "batch:recover-blocked": "tsx bin/enrichment-batch.ts recover-blocked",
    "cdk:synth": "cdk synth",
    "services": "node --env-file-if-exists=.env services/app.ts",
    "dev": "node --env-file-if-exists=.env --watch services/app.ts",
    "register": "node --env-file-if-exists=.env scripts/register-services.mjs",
    "reconcile": "node --env-file-if-exists=.env bin/reconcile-county.mjs",
    "enqueue": "node --env-file-if-exists=.env bin/enqueue-parcels.ts",
    "enqueue:permits": "node --env-file-if-exists=.env bin/enqueue-permits.ts",
    "status": "node --env-file-if-exists=.env bin/oracle-status.ts",
    "ramp": "node --env-file-if-exists=.env bin/ramp-scope.ts",
    "scope-cap": "node --env-file-if-exists=.env bin/scope-cap.ts",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "services:typecheck": "tsc -p tsconfig.services.json"
  },
  "dependencies": {
    "@aws-sdk/client-batch": "^3.1127.0",
    "@aws-sdk/client-cloudformation": "^3.1127.0",
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/client-sts": "^3.1127.0",
    "@dsnp/parquetjs": "^1.8.7",
    "@restatedev/restate-sdk": "1.18.4",
    "adm-zip": "^0.6.0",
    "cheerio": "^1.1.2",
    "puppeteer-core": "^25.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "aws-cdk": "^2.1140.0",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.0.14"
  }
}
