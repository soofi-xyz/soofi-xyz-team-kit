# Oracle runtime environment. Copy to .env (never commit .env).
# There is no database: run state lives in Restate, data lives in files.

# Data root (relative paths resolve against skills/use-oracle/runtime).
DATA_DIR=data

# Elephant CLI binary; Elephant CLI 2 preferred (prepare, transform, validate,
# hash, export-tables, upload). Set ELEPHANT_CLI_COMMIT when the binary does
# not print its build commit, so ready markers and gates report it.
ELEPHANT_CLI=/absolute/path/to/elephant-cli
# ELEPHANT_CLI_COMMIT=

# Services process and Restate endpoints.
SERVICES_PORT=9080
# auto = 127.0.0.1 + the Docker bridge gateway (docker0) that the compose
# Restate reaches through host.docker.internal. Never the public interfaces.
# Use 127.0.0.1 when Restate runs on the host; 0.0.0.0 only with identity keys.
SERVICES_HOST=auto
SERVICES_URL=http://host.docker.internal:9080
# Optional hardening: the publickeyv1_… key(s) Restate logs at startup when it
# has a request-identity private key (RESTATE_REQUEST_IDENTITY_PRIVATE_KEY_PEM_FILE).
# RESTATE_IDENTITY_KEYS=
RESTATE_ADMIN_URL=http://localhost:9070
RESTATE_INGRESS_URL=http://localhost:8080

# Compose overrides when another stack holds the default ports.
# COMPOSE_PROJECT_NAME=oracle-<county>-local
# RESTATE_INGRESS_PORT=8080
# RESTATE_ADMIN_PORT=9070        # Restate UI: http://127.0.0.1:<port>/ui
# RESTATE_NODE_NAME=restate-1   # only to adopt a volume created under another name
# Restate server (compose defaults shown). VQueues on a volume that ran
# without them is a one-way migration: back the volume up first.
# RESTATE_EXPERIMENTAL_ENABLE_VQUEUES=true
# RUST_MIN_STACK=16777216

# Flow control (enqueue path: npm run enqueue / enqueue:permits / ramp).
# One scope per source site; the rule on a scope caps how many invocations
# run at once. Scopes: lowercase letters, digits, '-'; at most 36 chars.
# APPRAISAL_SCOPE_<COUNTY>=<county>-appraisal   (share one scope across
#   counties served by the same site, e.g. qpublic)
# PERMIT_SCOPE_<COUNTY>_<ADAPTER>=<county>-permits-<adapter>
# Starting cap when a scope has no rule yet (appraisal default 6, permits 2).
# Never above 18 without a measured benchmark; ramp 6 -> 12 -> 18.
# SCOPE_CAP_<SCOPE>=6           e.g. SCOPE_CAP_COBB_APPRAISAL=6
# Hand-off links printed by npm run status (defaults: this user and hostname).
# ORACLE_SSH_USER=
# ORACLE_SSH_HOST=

# In-process concurrency gates (restart the services process to apply).
# On the enqueue path the capture gate must be ABOVE the scope cap so
# Restate's cap binds: set it above the top ramp level (e.g. 24 for 18).
CONCURRENCY_PREPARE=4
# CONCURRENCY_PREPARE_<COUNTY>=24
CONCURRENCY_TRANSFORM=8
# Permit gate per adapter: at or above that permit scope's cap.
CONCURRENCY_PERMIT_ACCELA=2

# Per-county capture and transform (<COUNTY> = slug uppercased, - → _).
# CAPTURE_MODULE_<COUNTY>=src/counties/<county>/capture.mjs
# PREPARE_URL_TEMPLATE_<COUNTY>=https://appraiser.example.gov/parcel?id={parcel_id}
#   (a query string is stored as multiValueQueryString; POST sources add
#   PREPARE_METHOD_<COUNTY>=POST and PREPARE_JSON_TEMPLATE_<COUNTY> or
#   PREPARE_BODY_TEMPLATE_<COUNTY> + PREPARE_CONTENT_TYPE_<COUNTY>)
# CAPTURE_TIMEOUT_MS_<COUNTY>=600000   # capture plug-in AbortSignal timeout
# PREPARE_MULTI_REQUEST_FLOW_<COUNTY>=counties/<county>/flow.json
# PREPARE_BROWSER_FLOW_<COUNTY>=flows/<county>.json
# PREPARE_USE_BROWSER_<COUNTY>=false
# TRANSFORM_ZIP_<COUNTY>=counties/<county>/transform-v2.zip
# TRANSFORM_SCRIPTS_DIR_<COUNTY>=counties/<county>/transforms
# TRANSFORM_DATA_GROUP_<COUNTY>=County
# COUNTY_NAME_<COUNTY>=Palm Beach

# Permit eligibility from transformed usage type: CSV, __ALL__ or __NONE__.
# Unset means __NONE__ (appraisal only).
# PROPERTY_FIRST_PERMIT_ELIGIBLE_USAGE_TYPES_<COUNTY>=__NONE__

# Permit harvest: options passed to the county's permit adapters.
# PERMIT_BULK_DIR_<COUNTY>=artifacts/permits/<county>/<snapshot-job>/bulk
#   (per-source <jurisdiction|route>/linked-permits.jsonl + summary.json;
#   read per parcel, live adapters when a jurisdiction has no snapshot)
# PERMIT_TIMEOUT_MS_<COUNTY>=60000
# PERMIT_MAX_ATTEMPTS_<COUNTY>=3
# PERMIT_CHROMIUM_PATH_<COUNTY>=/usr/bin/chromium   (else CHROME_EXECUTABLE_PATH)
# PERMIT_HEADLESS_<COUNTY>=true
# PERMIT_ADAPTER_OPTIONS_<COUNTY>={"someScalarOption":1}
# PERMIT_ROUTING_MODULE_<COUNTY>=src/counties/<county>/permit-routing.mjs

# Long-step timeouts (ms); defaults shown.
# PARCEL_INACTIVITY_TIMEOUT_MS=900000
# PARCEL_ABORT_TIMEOUT_MS=2700000
# PERMIT_INACTIVITY_TIMEOUT_MS=1200000
# PERMIT_ABORT_TIMEOUT_MS=3600000
# PUBLISH_INACTIVITY_TIMEOUT_MS=3600000
# PUBLISH_ABORT_TIMEOUT_MS=21600000

# Publication upload only (PublishGroup after approve). Never print these.
# IPFS_API=
# IPFS_API_TOKEN=
# ELEPHANT_CAR_GATEWAY=
# FILEBASE_ACCESS_KEY=
# FILEBASE_SECRET_KEY=
# FILEBASE_BUCKET=
