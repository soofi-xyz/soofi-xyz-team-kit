# Oracle runtime environment. Copy to .env (never commit .env).
# There is no database: run state lives in Restate, data lives in files.

# Data root (relative paths resolve against skills/use-oracle/runtime).
DATA_DIR=data

# Elephant CLI binary; Elephant CLI 2 preferred (prepare, transform, validate,
# hash, export-tables, upload). Set ELEPHANT_CLI_COMMIT when the binary does
# not print its build commit, so ready markers and gates report it.
ELEPHANT_CLI=/absolute/path/to/elephant-cli
# ELEPHANT_CLI_COMMIT=

# Services process and Restate endpoints.
SERVICES_PORT=9080
SERVICES_URL=http://host.docker.internal:9080
RESTATE_ADMIN_URL=http://localhost:9070
RESTATE_INGRESS_URL=http://localhost:8080

# Compose overrides when another stack holds the default ports.
# COMPOSE_PROJECT_NAME=oracle-<county>-local
# RESTATE_INGRESS_PORT=8080
# RESTATE_ADMIN_PORT=9070

# In-process concurrency gates (restart the services process to apply).
CONCURRENCY_PREPARE=4
# CONCURRENCY_PREPARE_<COUNTY>=4
CONCURRENCY_TRANSFORM=8
CONCURRENCY_PERMIT_ACCELA=2

# Per-county capture and transform (<COUNTY> = slug uppercased, - → _).
# CAPTURE_MODULE_<COUNTY>=src/counties/<county>/capture.mjs
# PREPARE_URL_TEMPLATE_<COUNTY>=https://appraiser.example.gov/parcel?id={parcel_id}
# PREPARE_MULTI_REQUEST_FLOW_<COUNTY>=counties/<county>/flow.json
# PREPARE_BROWSER_FLOW_<COUNTY>=flows/<county>.json
# PREPARE_USE_BROWSER_<COUNTY>=false
# TRANSFORM_ZIP_<COUNTY>=counties/<county>/transform-v2.zip
# TRANSFORM_SCRIPTS_DIR_<COUNTY>=counties/<county>/transforms
# TRANSFORM_DATA_GROUP_<COUNTY>=County
# COUNTY_NAME_<COUNTY>=Palm Beach

# Permit eligibility from transformed usage type: CSV, __ALL__ or __NONE__.
# Unset means __NONE__ (appraisal only).
# PROPERTY_FIRST_PERMIT_ELIGIBLE_USAGE_TYPES_<COUNTY>=__NONE__

# Long-step timeouts (ms); defaults shown.
# PARCEL_INACTIVITY_TIMEOUT_MS=900000
# PARCEL_ABORT_TIMEOUT_MS=2700000
# PERMIT_INACTIVITY_TIMEOUT_MS=1200000
# PERMIT_ABORT_TIMEOUT_MS=3600000
# PUBLISH_INACTIVITY_TIMEOUT_MS=3600000
# PUBLISH_ABORT_TIMEOUT_MS=21600000

# Publication upload only (PublishGroup after approve). Never print these.
# IPFS_API=
# IPFS_API_TOKEN=
# ELEPHANT_CAR_GATEWAY=
# FILEBASE_ACCESS_KEY=
# FILEBASE_SECRET_KEY=
# FILEBASE_BUCKET=
