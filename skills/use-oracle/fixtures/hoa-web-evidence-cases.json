{
  "schemaVersion": "elephant.hoa-web-evidence-fixtures.v1",
  "description": "Synthetic regression cases for HOA web evidence scope, address validation, fee extraction, fee and name adjudication, fee-period conversion, NetSuite gap scoring, and diagnosis. Every address, community, and URL is invented. Replayed by skills/use-oracle/runtime/tests/hoa-web-evidence.test.mjs; the `check` field selects the evaluator.",
  "cases": [
    {
      "id": "explicit-annual-must-stay-annual",
      "check": "observations",
      "requestedAddress": "100 Example Cove Ln, Jacksonville, FL 32218",
      "observedAddress": "100 Example Cove Ln, Jacksonville, FL 32218",
      "scope": "exact_property",
      "observations": [
        {
          "amountRaw": "$690",
          "amountUsd": 690,
          "frequencyRaw": "Annually",
          "expectedFrequencyCanonical": "Annually",
          "expectedAnnualizedUsd": 690
        }
      ],
      "expectedDiagnostic": "confirmed_match"
    },
