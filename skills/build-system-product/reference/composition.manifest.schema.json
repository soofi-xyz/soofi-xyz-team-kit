{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soofi.xyz/schemas/system/composition.manifest.schema.json",
  "title": "SystemCompositionManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "systemId",
    "outcome",
    "products",
    "configRefs",
    "workflow",
    "successCriteria",
    "dependencies",
    "deploy"
  ],
  "properties": {
    "contractVersion": {
      "type": "integer",
      "const": 1,
      "description": "System composition contract version. Only 1 is accepted."
    },
    "systemId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 2,
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "outcome": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2000
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product",
          "role"
        ],
        "properties": {
          "product": {
            "type": "string",
            "enum": [
              "product-orchestration",
              "lexicon",
              "connect",
              "transform",
              "translate",
              "persist",
              "deploy",
              "system-runtime",
              "batch"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "configure",
              "execute",
              "activate",
              "serve",
              "reference-only"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "configRefs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "product-definition",
              "product-schema",
              "product-flow-template",
              "product-flow",
              "product-waterfall",
              "product-invocation",
              "lexicon-catalog",
              "connect-source",
              "transform-request",
              "transform-mapping",
              "system-openapi",
              "system-fixtures",
              "deploy-environment",
              "other"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "digest": {
            "type": "string",
            "description": "Optional content digest when pinned."
          },
          "ownerAgent": {
            "type": "string",
            "enum": [
              "conkeldurr",
              "lapras",
              "kecleon",
              "zygarde",
              "machamp"
            ]
          }
        }
      }
    },
    "workflow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "product",
          "configRef",
          "agent",
          "gate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "product": {
            "type": "string",
            "enum": [
              "product-orchestration",
              "lexicon",
              "connect",
              "transform",
              "translate",
              "persist",
              "deploy",
              "system-runtime",
              "batch"
            ]
          },
          "configRef": {
            "type": "string",
            "minLength": 1
          },
          "agent": {
            "type": "string",
            "enum": [
              "conkeldurr",
              "lapras",
              "kecleon",
              "zygarde",
              "machamp"
            ]
          },
          "gate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "successCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "verify": {
            "type": "string",
            "enum": [
              "schema",
              "fixture",
              "openapi",
              "invocation",
              "integration",
              "manual",
              "deferred"
            ]
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repos": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "purpose"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activationEnabled"
      ],
      "properties": {
        "activationEnabled": {
          "type": "boolean",
          "const": false,
          "description": "System CDK stubs stay inactive by default."
        },
        "costCeilingUsd": {
          "type": "number",
          "minimum": 0
        },
        "regionHint": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "productName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Product service name when different from systemId."
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "product-service",
            "thin-package-deferred"
          ],
          "description": "Default product-service. thin-package-deferred requires deferred Product cutover criteria."
        },
        "invocationMode": {
          "type": "string",
          "enum": [
            "single_flow",
            "waterfall"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
}
