{
  "contractVersion": 1,
  "configurationVersion": "1.0.0",
  "systemId": "sale-availability",
  "productName": "sale-availability",
  "title": "Sale availability lookup",
  "outcome": "Given an address or parcelId, return sale availability and evidence from curated Connect/Transform artifacts via a Product invocation. Unknown identifiers fail closed. No scrape-on-request.",
  "orchestration": {
    "mode": "system-service",
    "invocationMode": "single",
    "notes": "Serve through the Base System /system API. Template-backed flow only."
  },
  "products": [
    {
      "product": "system-runtime",
      "role": "serve",
      "notes": "System hosts the Product definition, schemas, Flow Template, and Product Flow."
    },
    {
      "product": "lexicon",
      "role": "configure",
      "notes": "Publish source and sale-availability languages plus mapping."
    },
    {
      "product": "connect",
      "role": "execute",
      "notes": "Land prepared source objects with the existing partner-file-intake flow; partner configuration + activation only, no new verbs."
    },
    {
      "product": "transform",
      "role": "execute",
      "notes": "Translate source language to sale-availability language (contractVersion 2)."
    },
    {
      "product": "deploy",
      "role": "activate",
      "notes": "Keep activationEnabled false until authorized."
    }
  ],
  "configRefs": {
    "productDefinition": {
      "kind": "product-definition",
      "path": "product.definition.json",
      "ownerAgent": "zygarde"
    },
    "requestSchema": {
      "kind": "product-schema",
      "path": "schemas/request.schema.json",
      "ownerAgent": "zygarde"
    },
    "responseSchema": {
      "kind": "product-schema",
      "path": "schemas/response.schema.json",
      "ownerAgent": "zygarde"
    },
    "productFlowTemplate": {
      "kind": "product-flow-template",
      "path": "flow-templates/sale-availability-lookup.json",
      "ownerAgent": "zygarde"
    },
    "productFlow": {
      "kind": "product-flow",
      "path": "product-flows/default.json",
      "ownerAgent": "zygarde"
    },
    "productInvocation": {
      "kind": "product-invocation",
      "path": "invocation.contract.md",
      "ownerAgent": "zygarde"
    },
    "lexiconCatalog": {
      "kind": "lexicon-catalog",
      "path": "emits/lexicon/catalog.stub.json",
      "ownerAgent": "conkeldurr"
    },
    "connectPartner": {
      "kind": "connect-partner",
      "path": "emits/connect/partner.stub.json",
      "ownerAgent": "lapras"
    },
    "connectActivation": {
      "kind": "connect-activation",
      "path": "emits/connect/activation.stub.json",
      "ownerAgent": "lapras"
    },
    "transformRequest": {
      "kind": "transform-request",
      "path": "emits/transform/request.stub.json",
      "ownerAgent": "kecleon"
    },
    "deployEnvironment": {
      "kind": "deploy-environment",
      "path": "emits/deploy/environment.stub.json",
      "ownerAgent": "conkeldurr"
    }
  },
  "workflow": [
    {
      "id": "publish-lexicon",
      "product": "lexicon",
      "configRef": "lexiconCatalog",
      "agent": "conkeldurr",
      "gate": "languages-and-mapping-proposed"
    },
    {
      "id": "register-source",
      "product": "connect",
      "configRef": "connectPartner",
      "agent": "lapras",
      "gate": "partner-configuration-accepted"
    },
    {
      "id": "schedule-intake",
      "product": "connect",
      "configRef": "connectActivation",
      "agent": "lapras",
      "gate": "activation-registered-disabled"
    },
    {
      "id": "translate",
      "product": "transform",
      "configRef": "transformRequest",
      "agent": "kecleon",
      "gate": "curated-sale-availability-artifacts-written"
    },
    {
      "id": "configure-product",
      "product": "system-runtime",
      "configRef": "productDefinition",
      "agent": "zygarde",
      "gate": "product-schemas-accepted"
    },
    {
      "id": "compile-flow-template",
      "product": "system-runtime",
      "configRef": "productFlowTemplate",
      "agent": "zygarde",
      "gate": "flow-template-compiled"
    },
    {
      "id": "bind-product-flow",
      "product": "system-runtime",
      "configRef": "productFlow",
      "agent": "zygarde",
      "gate": "flow-template-name-bound"
    },
    {
      "id": "invoke-contract",
      "product": "system-runtime",
      "configRef": "productInvocation",
      "agent": "zygarde",
      "gate": "invocation-contract-documented"
    },
    {
      "id": "deploy-stub",
      "product": "deploy",
      "configRef": "deployEnvironment",
      "agent": "conkeldurr",
      "gate": "synth-with-activation-disabled"
    }
  ],
  "successCriteria": [
    {
      "id": "manifest-valid",
      "description": "scripts/check-system-manifest.py passes: schema, references, emit contracts.",
      "verify": "schema"
    },
    {
      "id": "template-backed-flow",
      "description": "Every product flow stub sets flow_template_name to an emitted template; no legacy default connector pipeline.",
      "verify": "schema"
    },
    {
      "id": "invocation-known-key",
      "description": "Known address/parcelId invocation returns availability + evidence (deferred until System + leaf wiring).",
      "verify": "deferred"
    },
    {
      "id": "unknown-id-closed",
      "description": "Unknown address/parcelId fails closed with typed error (deferred).",
      "verify": "deferred"
    },
    {
      "id": "no-scrape",
      "description": "Request path does not perform live website scraping.",
      "verify": "manual"
    }
  ],
  "dependencies": {
    "repos": [
      "prismteam-ai/system",
      "StaircaseAPI/product",
      "elephant-xyz/lexicon",
      "elephant-xyz/connect",
      "elephant-xyz/transform"
    ],
    "env": [
      {
        "name": "ELEPHANT_LEXICON_ROOT",
        "purpose": "Local or checkout path to Elephant Lexicon for catalog resolution."
      }
    ],
    "notes": "Primary runtime is Base System. Staircase Product is behavioral evidence only."
  },
  "deploy": {
    "activationEnabled": false,
    "costCeilingUsd": 25,
    "notes": "Do not enable activation without account/region authorization and System plus leaf wiring evidence."
  },
  "evidence": {
    "level": "spec",
    "artifacts": [
      "system.manifest.json"
    ],
    "notes": "Example contract only; no synth, deployment, or live invocation is claimed."
  }
}
