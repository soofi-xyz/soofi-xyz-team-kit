{
  "version": "3",
  "flow_name": "partner-bucket-objects",
  "kind": "flow",
  "description": "Copy named objects from a partner-owned bucket (for example Interprose's customer document bucket) into the Connect bucket, using a cross-account role.",
  "connections": {
    "bucket": { "types": ["s3", "azure_blob", "sftp"] }
  },
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "oneOf": [{ "required": ["keys"] }, { "required": ["keys_file"] }],
    "properties": {
      "keys": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "string" } },
      "keys_file": { "type": "object" }
    }
  },
  "triggers": ["api"],
  "limits": { "timeout_seconds": 21600, "max_items": 200000, "max_bytes": 107374182400 },
  "definition": {
    "StartAt": "HasInlineKeys",
    "States": {
      "HasInlineKeys": {
        "Type": "Choice",
        "Choices": [{ "Variable": "$.request.keys", "IsPresent": true, "Next": "CopyInline" }],
        "Default": "CopyFromFile"
      },
      "CopyInline": {
        "Type": "Map",
        "Items": "$.request.keys",
        "Concurrency": 50,
        "Iterator": {
          "StartAt": "Fetch",
          "States": {
            "Fetch": {
              "Type": "Task",
              "ResourceDefinition": {
                "Type": "FETCH", "Connection": "bucket", "Path": "$.item",
                "Verify": { "Size": true }, "SaveOutputTo": "$.vars.landed"
              },
              "End": true
            }
          }
        },
        "End": true
      },
      "CopyFromFile": {
        "Type": "Map",
        "ItemsFrom": { "File": "$.request.keys_file", "Format": "csv", "CsvHeader": true },
        "Concurrency": 100,
        "Iterator": {
          "StartAt": "Fetch",
          "States": {
            "Fetch": {
              "Type": "Task",
              "ResourceDefinition": {
                "Type": "FETCH", "Connection": "bucket", "Path": "$.item.key",
                "Verify": { "Size": true }, "SaveOutputTo": "$.vars.landed"
              },
              "End": true
            }
          }
        },
        "End": true
      }
    }
  }
}
