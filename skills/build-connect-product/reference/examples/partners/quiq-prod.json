{
  "configuration_id": "quiq-prod",
  "partner": "quiq",
  "tenant": "socapital",
  "environment": "prod",
  "connections": {
    "provider": {
      "type": "http",
      "base_url": "https://<tenant>.goquiq.com",
      "auth": { "profile": "basic", "credential": "quiq-api" }
    },
    "drop": {
      "type": "drop_zone",
      "prefix": "bi-data/",
      "max_object_bytes": 5368709120,
      "auth": { "profile": "partner_principal" }
    }
  },
  "webhooks": {
    "events": {
      "auth": { "scheme": "header_secret", "header": "X-Webhook-Secret", "credential": "quiq-webhook" }
    },
    "status": {
      "auth": { "scheme": "header_secret", "header": "X-Webhook-Secret", "credential": "quiq-webhook" }
    }
  }
}
