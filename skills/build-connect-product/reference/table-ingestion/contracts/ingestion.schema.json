{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:connect:ingestion:contracts:1",
  "title": "Connect ingestion contracts",
  "$defs": {
    "Artifact": {
      "type": "object",
      "properties": {
        "s3Uri": {
          "type": "string",
          "pattern": "^s3://[a-z0-9][a-z0-9.-]+/[^?#]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "s3Uri",
        "sha256"
      ],
      "additionalProperties": false
    },
    "SourceIdentity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "SourceCatalog": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "$ref": "#/$defs/SourceIdentity"
              },
              "artifact": {
                "$ref": "#/$defs/Artifact"
              }
            },
            "required": [
              "source",
              "artifact"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "contractVersion",
        "revision",
        "sources"
      ],
      "additionalProperties": false
    },
    "SourceRead": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "full",
            "timestamp_window",
            "append_window"
          ]
        },
        "cursorColumn": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "lookbackSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "timestamp_window",
                  "append_window"
                ]
              }
            }
          },
          "then": {
            "required": [
              "cursorColumn"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "full"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "cursorColumn"
                  ]
                },
                {
                  "required": [
                    "lookbackSeconds"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "EntityLink": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "direct"
            },
            "column": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "kind",
            "column"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "bridge"
            },
            "sourceColumn": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "bridgeTable": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "bridgeSourceColumn": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "bridgeEntityColumn": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "kind",
            "sourceColumn",
            "bridgeTable",
            "bridgeSourceColumn",
            "bridgeEntityColumn"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SourceLocation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "relation": {
              "type": "object",
              "properties": {
                "schema": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "table": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                }
              },
              "required": [
                "schema",
                "table"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "relation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "query": {
              "$ref": "#/$defs/Artifact"
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "object": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^?#]+$"
                },
                "sheet": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 31
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "object"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Table": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/SourceLocation"
        },
        "sparkSchema": {
          "$ref": "#/$defs/Artifact"
        },
        "recordKey": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "entityLink": {
          "$ref": "#/$defs/EntityLink"
        },
        "operationalColumns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "dropColumns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "predicate": {
          "$ref": "#/$defs/Artifact"
        },
        "read": {
          "$ref": "#/$defs/SourceRead"
        },
        "output": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "current_entity_bundle",
                "loaded_window",
                "latest_context"
              ]
            },
            "contextQuery": {
              "$ref": "#/$defs/Artifact"
            },
            "maxRowsPerEntity": {
              "type": "integer",
              "minimum": 1
            },
            "jdbcContextQuery": {
              "$ref": "#/$defs/Artifact"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "latest_context"
                  }
                }
              },
              "then": {
                "required": [
                  "contextQuery",
                  "maxRowsPerEntity",
                  "jdbcContextQuery"
                ]
              }
            }
          ]
        },
        "partition": {
          "type": "object",
          "properties": {
            "column": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          },
          "required": [
            "column",
            "count"
          ],
          "additionalProperties": false
        },
        "outputSparkSchema": {
          "$ref": "#/$defs/Artifact"
        }
      },
      "required": [
        "enabled",
        "source",
        "sparkSchema",
        "recordKey",
        "entityLink",
        "operationalColumns",
        "dropColumns",
        "read",
        "output",
        "outputSparkSchema"
      ],
      "additionalProperties": false
    },
    "ObservationPolicy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "enabled": {
          "type": "boolean"
        },
        "table": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "mode": {
          "enum": [
            "transition",
            "retained"
          ]
        },
        "canonicalQuery": {
          "$ref": "#/$defs/Artifact"
        },
        "sourceColumns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "outputColumn": {
          "type": "string",
          "pattern": "^_connect_[a-z0-9_]+$"
        },
        "timestampSource": {
          "enum": [
            "execution",
            "source"
          ]
        },
        "sourceTimestampColumn": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "initialMode": {
          "enum": [
            "seed",
            "emit"
          ]
        }
      },
      "required": [
        "id",
        "enabled",
        "table",
        "mode",
        "canonicalQuery",
        "sourceColumns",
        "outputColumn",
        "timestampSource",
        "initialMode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "timestampSource": {
                "const": "source"
              }
            }
          },
          "then": {
            "required": [
              "sourceTimestampColumn"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "transition"
              }
            }
          },
          "then": {
            "properties": {
              "timestampSource": {
                "const": "execution"
              }
            }
          }
        }
      ]
    },
    "SourceDefinition": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "source": {
          "$ref": "#/$defs/SourceIdentity"
        },
        "enabled": {
          "type": "boolean"
        },
        "adapter": {
          "enum": [
            "postgres-jdbc",
            "s3-file"
          ]
        },
        "sourceLanguage": {
          "$ref": "#/$defs/SourceIdentity"
        },
        "entity": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "rootTable": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "idColumn": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "related": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                    },
                    "direction": {
                      "const": "outgoing"
                    },
                    "hops": {
                      "const": 1
                    }
                  },
                  "required": [
                    "column",
                    "direction",
                    "hops"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "rootTable",
            "idColumn",
            "related"
          ],
          "additionalProperties": false
        },
        "tables": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Table"
          },
          "minProperties": 1
        },
        "projection": {
          "$ref": "#/$defs/Artifact"
        },
        "dependencies": {
          "$ref": "#/$defs/Artifact"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObservationPolicy"
          },
          "minItems": 0
        },
        "delivery": {
          "type": "object",
          "properties": {
            "boundary": {
              "enum": [
                "after_consumer",
                "after_extract"
              ]
            },
            "consumerId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "boundary",
            "consumerId"
          ],
          "additionalProperties": false
        },
        "connection": {
          "anyOf": [
            {
              "$ref": "#/$defs/JdbcConnection"
            },
            {
              "$ref": "#/$defs/S3FileConnection"
            }
          ]
        }
      },
      "required": [
        "contractVersion",
        "source",
        "enabled",
        "adapter",
        "sourceLanguage",
        "connection",
        "entity",
        "tables",
        "projection",
        "dependencies",
        "observations",
        "delivery"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "adapter": {
                "const": "postgres-jdbc"
              }
            }
          },
          "then": {
            "properties": {
              "connection": {
                "$ref": "#/$defs/JdbcConnection"
              },
              "tables": {
                "additionalProperties": {
                  "properties": {
                    "source": {
                      "not": {
                        "required": [
                          "object"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "adapter": {
                "const": "s3-file"
              }
            }
          },
          "then": {
            "properties": {
              "connection": {
                "$ref": "#/$defs/S3FileConnection"
              },
              "tables": {
                "additionalProperties": {
                  "properties": {
                    "source": {
                      "required": [
                        "object"
                      ]
                    },
                    "read": {
                      "properties": {
                        "mode": {
                          "const": "full"
                        }
                      }
                    },
                    "output": {
                      "properties": {
                        "mode": {
                          "const": "current_entity_bundle"
                        }
                      }
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "predicate"
                        ]
                      },
                      {
                        "required": [
                          "partition"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "Projection": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "source": {
          "$ref": "#/$defs/SourceIdentity"
        },
        "mappingRevision": {
          "type": "string",
          "minLength": 1
        },
        "tables": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "required": [
        "contractVersion",
        "source",
        "mappingRevision",
        "tables"
      ],
      "additionalProperties": false
    },
    "Dependencies": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "source": {
          "$ref": "#/$defs/SourceIdentity"
        },
        "mappingRevision": {
          "type": "string",
          "minLength": 1
        },
        "closure": {
          "const": true
        },
        "dependencies": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      },
      "required": [
        "contractVersion",
        "source",
        "mappingRevision",
        "closure",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "entityIds": {
          "$ref": "#/$defs/Artifact"
        },
        "entityLimit": {
          "type": "integer",
          "minimum": 1
        },
        "dateWindows": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "column": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "fromInclusive": {
                "type": "string",
                "format": "date-time"
              },
              "toExclusive": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "column",
              "fromInclusive",
              "toExclusive"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Request": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "source": {
          "$ref": "#/$defs/SourceIdentity"
        },
        "mode": {
          "enum": [
            "delta",
            "baseline",
            "tables",
            "backfill",
            "sample"
          ]
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "projectionOverride": {
          "$ref": "#/$defs/Artifact"
        },
        "sample": {
          "type": "object",
          "properties": {
            "source": {
              "enum": [
                "materialized",
                "jdbc"
              ]
            },
            "fromResult": {
              "$ref": "#/$defs/Artifact"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "materialized"
                  }
                }
              },
              "then": {
                "required": [
                  "fromResult"
                ]
              }
            }
          ]
        },
        "authoritativeInitialObservations": {
          "type": "boolean"
        }
      },
      "required": [
        "contractVersion",
        "source",
        "mode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "tables"
              }
            }
          },
          "then": {
            "required": [
              "tables"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "sample"
              }
            }
          },
          "then": {
            "required": [
              "scope",
              "sample"
            ]
          }
        },
        {
          "if": {
            "required": [
              "sample"
            ]
          },
          "then": {
            "properties": {
              "mode": {
                "const": "sample"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "projectionOverride"
            ]
          },
          "then": {
            "properties": {
              "mode": {
                "const": "sample"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "backfill"
              }
            }
          },
          "then": {
            "required": [
              "scope"
            ]
          }
        }
      ]
    },
    "Environment": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "stage": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "accountId": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "local",
            "aws"
          ]
        },
        "catalogS3Uri": {
          "type": "string",
          "pattern": "^s3://[a-z0-9][a-z0-9.-]+/[^?#]+$"
        },
        "dataBucket": {
          "type": "string",
          "minLength": 1
        },
        "configurationPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^s3://[a-z0-9][a-z0-9.-]+/[^?#]+$"
          },
          "minItems": 1
        },
        "localObjectRoot": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "object",
          "properties": {
            "glueVersion": {
              "const": "5.0"
            },
            "workerType": {
              "const": "G.2X"
            },
            "workers": {
              "type": "integer",
              "minimum": 2,
              "maximum": 100
            },
            "timeoutMinutes": {
              "type": "integer",
              "minimum": 1
            },
            "maxJdbcConnections": {
              "type": "integer",
              "minimum": 1
            },
            "hydrationChunkSize": {
              "type": "integer",
              "minimum": 1
            },
            "maxSampleEntities": {
              "type": "integer",
              "minimum": 1
            },
            "maxPlanBytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "glueVersion",
            "workerType",
            "workers",
            "timeoutMinutes",
            "maxJdbcConnections",
            "hydrationChunkSize",
            "maxSampleEntities",
            "maxPlanBytes"
          ],
          "additionalProperties": false
        },
        "cost": {
          "type": "object",
          "properties": {
            "dpuHourUsd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "priceAsOf": {
              "type": "string",
              "format": "date"
            },
            "maximumRunUsd": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "dpuHourUsd",
            "priceAsOf",
            "maximumRunUsd"
          ],
          "additionalProperties": false
        },
        "metricsNamespace": {
