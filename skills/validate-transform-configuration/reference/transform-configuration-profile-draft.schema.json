{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transform-configuration-profile-draft.schema.json",
  "title": "Transform configuration discovery and intake draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contractVersion",
    "intakeState",
    "originalRequest",
    "candidateProfiles",
    "selectedProfile",
    "discoveryTrace",
    "materialFacts",
    "boundaryDecisions",
    "unresolvedFacts",
    "promotionEligible",
    "sensitivity",
    "localLocation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^transform-configuration-draft-[a-f0-9]{12,64}$"
    },
    "contractVersion": {
      "const": 1
    },
    "intakeState": {
      "enum": [
        "DISCOVERING",
        "NEEDS_INPUT",
        "CONTEXT_COMPLETE",
        "VALIDATING"
      ]
    },
    "originalRequest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "candidateProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profileId",
          "disposition",
          "hardSignals",
          "reason"
        ],
        "properties": {
          "profileId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
          },
          "disposition": {
            "enum": [
              "CANDIDATE",
              "SELECTED",
              "REJECTED"
            ]
          },
          "hardSignals": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/evidenceId"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "selectedProfile": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
        },
        {
          "type": "null"
        }
      ]
    },
    "discoveryTrace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "subject",
          "result",
          "evidenceIds"
        ],
        "properties": {
          "kind": {
            "enum": [
              "workspace",
              "repository",
              "pull-request",
              "mapping",
              "language",
              "sample-metadata",
              "profile"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/evidenceId"
            }
          }
        }
      }
    },
    "materialFacts": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "value",
          "evidenceIds",
          "nextQuestion"
        ],
        "properties": {
          "id": {
            "enum": [
              "source-and-target-meaning",
              "required-directions",
              "configuration-repository-and-ref",
              "environment-region-and-mode",
              "sample-or-evidence-source",
              "sensitivity-and-handling",
              "required-fields-and-permitted-losses",
              "consumer-and-readback",
              "success-scale-and-cost",
              "configuration-product-boundary"
            ]
          },
          "state": {
            "enum": [
              "CONFIRMED",
              "INFERRED",
              "AMBIGUOUS",
              "MISSING"
            ]
          },
          "value": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4000
          },
          "evidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/evidenceId"
            }
          },
          "nextQuestion": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        }
      }
    },
    "boundaryDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "classification",
          "reason",
          "evidenceIds"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/evidenceId"
          },
          "classification": {
            "enum": [
              "CONFIGURATION",
              "PRODUCT_CHANGE",
              "UNRESOLVED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 3
          },
          "evidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/evidenceId"
            }
          }
        }
      }
    },
    "unresolvedFacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "source-and-target-meaning",
          "required-directions",
          "configuration-repository-and-ref",
          "environment-region-and-mode",
          "sample-or-evidence-source",
          "sensitivity-and-handling",
          "required-fields-and-permitted-losses",
          "consumer-and-readback",
          "success-scale-and-cost",
          "configuration-product-boundary"
        ]
      }
    },
    "promotionEligible": {
      "type": "boolean"
    },
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containsRawPii",
        "containsSecrets"
      ],
      "properties": {
        "containsRawPii": {
          "const": false
        },
        "containsSecrets": {
          "const": false
        }
      }
    },
    "localLocation": {
      "type": "string",
      "pattern": "^local://transform-configuration-intake/[a-z0-9][a-z0-9-]*$"
    },
    "derivedSourceWindowPolicy": {
      "type": "object",
      "description": "PROD-derived source window policy derived by draft-profile from the workflow's external inputs; promotion copies it into sourceWindowPolicy with its recorded defaults.",
      "required": [
        "kind",
        "minimumCompleteUtcDays",
        "allowLongerRange",
        "requiredSourceFamilies",
        "requiredCoverageSignals",
        "origin",
        "recordedDefaults",
        "evidenceIds"
      ],
      "properties": {
        "kind": {
          "const": "prod-derived-complete-utc-days"
        },
        "minimumCompleteUtcDays": {
          "type": "integer",
          "minimum": 1
        },
        "allowLongerRange": {
          "type": "boolean"
        },
        "requiredSourceFamilies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "requiredCoverageSignals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceId"
          }
        },
        "origin": {
          "const": "derived-at-intake"
        },
        "recordedDefaults": {
          "type": "object"
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceId"
          }
        }
      },
      "additionalProperties": false
    },
    "derivedDirections": {
      "type": "array",
      "description": "Profile directions regenerated from the registry by draft-profile (registration + language definitions only).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "fromLanguage",
          "toLanguage",
          "mapping",
          "outputContracts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fromLanguage": {
            "type": "string"
          },
          "toLanguage": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "mapping": {
            "type": "object"
          },
          "outputContracts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "derivationFindings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "versionSelection": { "$ref": "#/$defs/versionSelection" }
  },
  "$defs": {
    "versionSelection": {
      "description": "How the mapping version was chosen. Without @x.y.z the rule is latest-published-semver: the highest semantic version among the published ENABLED versions of one mapping id, announced by notice. The chosen mapping.json is pinned by SHA-256.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "mappingId",
        "candidates",
        "chosen",
        "rule",
        "pin"
      ],
      "properties": {
        "requested": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "mappingId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "publishedIn"
            ],
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "publishedIn": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        },
        "chosen": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "rule": {
          "enum": [
            "explicit-version",
            "latest-published-semver",
            "single-match",
            "cumulative-superset"
          ]
        },
        "notice": {
          "type": "string",
          "minLength": 1
        },
        "pin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "sha256"
          ],
          "properties": {
            "source": {
              "enum": [
                "published-registry",
                "checked-in-registration"
              ]
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rule": {
                "const": "latest-published-semver"
              }
            },
            "required": [
              "rule"
            ]
          },
          "then": {
            "required": [
              "notice"
            ],
            "properties": {
              "requested": {
                "type": "null"
              },
              "pin": {
                "properties": {
                  "source": {
                    "const": "published-registry"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "rule": {
                "const": "explicit-version"
              }
            },
            "required": [
              "rule"
            ]
          },
          "then": {
            "properties": {
              "requested": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
