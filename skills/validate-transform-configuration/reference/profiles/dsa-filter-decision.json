  "evidencePolicy": {
    "sensitivity": "restricted",
    "sanitization": "aggregates-and-digests-only",
    "allowed": [
      "counts",
      "schemas",
      "sha256",
      "statuses",
      "durations",
      "costs",
      "credential-free-locations"
    ],
    "prohibited": [
      "raw-pii",
      "business-identifiers",
      "secret-values",
      "credentials",
      "signed-urls",
      "source-rows"
    ]
  },
  "graph": {
    "required": true,
    "identityRules": [
      "Derive stable product_execution identities for parent runs and child chunks from declared Decision run and chunk identity fields",
      "Derive stable product_execution_includes_debt and company_represents_debt edge identities from declared normalized endpoints and source event identity",
      "Never emit client identifiers into validation evidence"
    ],
    "endpointRules": [
      "Every product_has_execution edge resolves product to a parent product_execution",
      "Every child product_execution resolves to exactly one parent product_execution",
      "Every product_execution_includes_debt edge resolves product_execution to debt",
      "Every company_represents_debt edge resolves a DEBT_SETTLEMENT_AGENCY company to debt",
      "Dangling endpoint count must equal zero"
    ]
  },
  "adapters": [
