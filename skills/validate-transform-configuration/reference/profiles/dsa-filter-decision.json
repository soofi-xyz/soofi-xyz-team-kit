{
  "id": "dsa-filter-decision.json",
  "contractVersion": 1,
  "terminologyAliases": {
    "decision": [
      "filter outcome",
      "eligibility decision",
      "rule result"
    ],
    "client-event": [
      "client ID event",
      "partner record event"
    ],
    "form-output": [
      "form 1281",
      "partner decision form"
    ]
  },
  "roles": {
    "source": "Registered Decision datasets from the source workflow",
    "target": "Lexicon graph records, reconstructed Decision datasets, and Interprose form-1281 rows"
  },
  "transformClassification": {
    "kind": "deterministic",
    "evidenceBasis": "The profile selects three registered, version-controlled Spark SQL mappings with fixed Decision, graph, and form-1281 projections; readiness still requires pinned implementation and execution evidence.",
    "expectedOutputTests": [
      "decision-lexicon-decision-round-trip",
      "lexicon-interprose-form-1281",
      "full-utc-day-decision-coverage",
      "decision-sql-executed"
    ],
    "negativeTests": [
      "conflicting-client-event",
      "dsa-latest-edge-regression",
      "mixed-run-rejected-path",
      "missing-authoritative-endpoint",
      "invalid-evidence-package",
      "unsupported-mapping-option"
    ]
  },
  "configurationChoices": {
    "fieldNames": [
      "all fields from six Decision datasets and all seven Interprose form-1281 fields"
    ],
    "schemaShape": [
      "Decision fields are additive optional properties on canonical product_execution, product_execution_includes_debt, and company_represents_debt concepts"
    ],
    "formats": [
      "Decision JSONL, Neptune-profile graph CSV, graph Parquet input, and Interprose JSONL"
    ],
    "normalizationRules": [
      "parent and child product-execution joins, deterministic latest company-represents-debt event per debt, nullable effective_at, and form constants"
    ],
    "mappingExpressions": [
      "decision-to-lexicon@1.0.0",
      "lexicon-to-decision@1.0.0",
      "lexicon-to-interprose@3.0.0"
    ],
    "profileInputs": [
      "one complete 2026-09-18 UTC DEV day and the sanitized 20260915 mixed rejected-path run"
    ],
    "vocabularySelections": [
      "registered Decision, Lexicon, and Interprose definitions"
    ]
  },
  "productBoundary": {
    "prohibitedAsConfiguration": [
      "representation-family",
      "identity-scheme",
      "executable-code-path",
      "dependency-type",
      "storage-engine-mode",
      "failure-semantics"
    ],
    "onDetection": "block-and-handoff"
  },
