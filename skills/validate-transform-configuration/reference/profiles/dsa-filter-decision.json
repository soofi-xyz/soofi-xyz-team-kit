  "invariants": [
    {
      "id": "one-outcome-per-debt",
      "description": "Every evaluated debt is linked through product_execution_includes_debt carrying outcome, chunk_index, both rule booleans, and source_run_id with one outcome per source debt",
      "phase": 9,
      "failureCode": "DecisionCardinalityMismatch"
    },
    {
      "id": "declared-decision-graph-model",
      "description": "Decision output uses only active canonical product, product_execution, ruleset, debt, company and company_represents_debt concepts; removed Rule-specific execution concepts are forbidden",
      "phase": 10,
      "failureCode": "DecisionGraphShapeMismatch"
    },
    {
      "id": "decision-fields-carried",
      "description": "Canonical graph outputs carry 16 decision_batch fields, 7 chunk_executions fields, 4 debt_outcomes fields, 5 rule_evaluations fields, 7 dsa_client_id_updates fields, and all graph_identity_references fields without field loss",
      "phase": 9,
      "failureCode": "DecisionFieldLoss"
    },
    {
      "id": "chunk-parent-closure",
      "description": "Each chunk is a child product_execution linked to exactly one parent run product_execution and both identities remain stable through reverse transformation",
      "phase": 10,
      "failureCode": "DecisionChunkParentMismatch"
    },
    {
      "id": "full-day-decision-coverage",
      "description": "The half-open 2026-09-18 UTC day contains all six Decision source families, accepted and rejected outcomes, client events, and at least one decision_batch status not_required run",
      "phase": 9,
      "failureCode": "DecisionFullDayCoverageMismatch"
    },
    {
      "id": "authoritative-endpoints-close",
      "description": "Every emitted graph edge resolves to a declared authoritative endpoint",
      "phase": 10,
      "failureCode": "DecisionEndpointMismatch"
    },
    {
      "id": "decision-round-trip-reconciles",
      "description": "The inverse mapping reconstructs all fields of all six Decision datasets directly from canonical graph facts without Persist",
      "phase": 11,
      "failureCode": "DecisionRoundTripMismatch"
    },
    {
      "id": "form-projection-reconciles",
      "description": "The form_1281 projection selects the deterministic latest client-ID event from company_represents_debt and preserves five source fields plus two constants",
      "phase": 11,
      "failureCode": "FormProjectionMismatch"
    },
    {
      "id": "dsa-latest-edge-wins",
      "description": "For each debt, form_1281 selects the deterministic latest company_represents_debt event where company_type is DEBT_SETTLEMENT_AGENCY, preserves its five event fields, and rejects stale competing events",
      "phase": 11,
      "failureCode": "DecisionLatestClientEventMismatch"
    },
    {
      "id": "client-event-fields-carried",
      "description": "company_represents_debt carries dsc_client_id, source_run_id, idempotency_key, event_type, and client_event_schema_version and is emitted with company_type DEBT_SETTLEMENT_AGENCY, source status, and version 2",
      "phase": 9,
      "failureCode": "DecisionClientEventFieldLoss"
    },
    {
      "id": "decision-sql-executed",
      "description": "Runtime evidence must identify executed Decision SQL digests and physical outputs for every required direction; registration-only tests never satisfy this invariant",
      "phase": 9,
      "failureCode": "DecisionSqlNotExecuted"
    }
  ],
