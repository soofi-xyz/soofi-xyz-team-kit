{
  "id": "registry-layout.json",
  "contractVersion": 1,
  "description": "Where a Lexicon-style registry keeps languages, mappings and publication metadata. The resolver, fetcher and run tools read every repository path, SSM name and default from this file; pass --layout to use another registry.",
  "repository": {
    "slug": "Spring-Oaks-Capital-LLC/lexicon",
    "defaultRegion": "us-east-2"
  },
  "hubLanguage": "lexicon",
  "conceptModelPath": "src/data/lexicon.json",
  "languageDefinitionPath": "src/data/{language}.json",
  "languageRegistry": {
    "path": "src/data/lexicons.ts",
    "blockPattern": "export const lexicons[^=]*=\\s*\\{(.*?)\\n\\};",
    "keyPattern": "^\\s{2}(\\w+):\\s*\\{"
  },
  "languageParameters": {
    "declaredIn": "infra/lib/lexicon-stack.ts",
    "declarationPattern": "parameterName:\\s*\"(/lexicon/[a-z0-9-]*data-uri)\"",
    "parameterPattern": "/lexicon/[a-z0-9-]*data-uri",
    "prefix": "/lexicon/",
    "suffix": "data-uri"
  },
  "registrationGlob": "src/transform/mappings/**/registration.json",
  "retiredMappingIds": {
    "path": "infra/test/transform-mappings.spec.ts",
    "listPattern": "const retired of \\[(.*?)\\]"
  },
  "publishedRegistry": {
    "uriParameter": "/lexicon/transform-mappings-uri",
    "parameterPath": "/lexicon",
    "mappingGlob": "transform-mappings/*/*/mapping.json"
  },
  "graphDatasetPrefixes": ["vertex", "edge"],
  "materialize": {
    "install": ["npm ci --no-audit --no-fund", "npm ci --no-audit --no-fund --prefix infra"],
    "command": "npx tsx infra/test/spark/materialize-mappings.ts {out}",
    "node": {
      "minimumMajor": 18,
      "recommended": "22.18",
      "reason": "tsx (the materialize command) needs Node.js 18+; CI uses 22.18. Older supported majors work but npm may print EBADENGINE warnings, so they are warned about, not blocked."
    }
  },
  "persist": {
    "apiUrlParameter": "persist-api-url",
    "gremlinPath": "/persist/gremlin",
    "service": "execute-api"
  },
  "transformRuntime": {
    "stateMachineSuffix": "-transform-pipeline",
    "planKey": "runs/{executionName}/plan.json",
    "outputTablesDir": "tables",
    "glueUsdPerDpuHour": 0.44
  }
}
