    "dsa": "dsa",
    "m2d": "m2d"
  },
  "slices": {
    "sms": {
      "id": "sms",
      "outputDatasets": ["sms_log"],
      "introducedIn": "2.0.0"
    },
    "dsa": {
      "id": "dsa",
      "outputDatasets": ["form_1281"],
      "introducedIn": "4.0.0"
    },
    "m2d": {
      "id": "m2d",
      "outputDatasets": ["document_registration", "document_registration_rejects"],
      "introducedIn": "5.0.0"
    }
  }
}
