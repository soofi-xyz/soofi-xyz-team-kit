{
  "id": "package-slices.json",
  "contractVersion": 1,
  "description": "Named output slices of one Transform mapping package. A request 'validate <from> to <to> for <slice>, <slice> and <slice>' selects this package and one outputDatasets set per slice. Slice words are not languages and do not select a different mapping.",
