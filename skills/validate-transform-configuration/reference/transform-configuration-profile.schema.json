{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transform-configuration-profile.schema.json",
  "title": "Transform configuration input profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contractVersion",
    "terminologyAliases",
    "roles",
    "transformClassification",
    "configurationChoices",
    "productBoundary",
    "datasets",
    "invariants",
    "repositories",
    "discoveryProbes",
    "directions",
    "validationWorkflow",
    "validationSources",
    "evidencePolicy",
    "graph",
    "adapters",
    "consumers",
    "sourceWindowPolicy",
    "scaleTiers",
    "approvals"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
    },
    "contractVersion": {
      "const": 1
    },
    "terminologyAliases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 2
        },
        "target": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "transformClassification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "evidenceBasis",
            "expectedOutputTests",
            "negativeTests"
          ],
          "properties": {
            "kind": {
              "const": "deterministic"
            },
            "evidenceBasis": {
              "type": "string",
              "minLength": 10
            },
            "expectedOutputTests": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/kebab"
              }
            },
            "negativeTests": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/kebab"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "evidenceBasis",
            "confidenceOutput",
            "thresholds",
            "humanReviewPolicy"
          ],
          "properties": {
            "kind": {
              "const": "non-deterministic"
            },
            "evidenceBasis": {
              "type": "string",
              "minLength": 10
            },
            "confidenceOutput": {
              "type": "string",
              "minLength": 3
            },
            "thresholds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "humanReviewPolicy": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      ]
    },
    "configurationChoices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldNames",
        "schemaShape",
        "formats",
        "normalizationRules",
        "mappingExpressions",
        "profileInputs",
        "vocabularySelections"
      ],
      "properties": {
        "fieldNames": {
          "$ref": "#/$defs/stringList"
        },
        "schemaShape": {
          "$ref": "#/$defs/stringList"
        },
        "formats": {
          "$ref": "#/$defs/stringList"
        },
        "normalizationRules": {
          "$ref": "#/$defs/stringList"
        },
        "mappingExpressions": {
          "$ref": "#/$defs/stringList"
        },
        "profileInputs": {
          "$ref": "#/$defs/stringList"
        },
        "vocabularySelections": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "productBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prohibitedAsConfiguration",
        "onDetection"
      ],
      "properties": {
        "prohibitedAsConfiguration": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "representation-family",
              "identity-scheme",
              "executable-code-path",
              "dependency-type",
              "storage-engine-mode",
              "failure-semantics"
            ]
          }
        },
        "onDetection": {
          "const": "block-and-handoff"
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dataset"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "purpose",
          "role",
          "revisionPolicy",
          "candidateDiscovery",
          "requiredPaths"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "purpose": {
            "type": "string",
            "minLength": 3
          },
          "role": {
            "enum": [
              "configuration-source",
              "product-runtime",
              "domain-contract"
            ]
          },
          "revisionPolicy": {
            "const": "commit-sha"
          },
          "candidateDiscovery": {
            "enum": [
              "requested-ref-then-default-branch",
              "requested-ref-then-matching-open-pr-then-default-branch"
            ]
          },
          "requiredPaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/repositoryPath"
            }
          }
        }
      }
    },
    "discoveryProbes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "description",
          "readOnly"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/kebab"
          },
          "kind": {
            "enum": [
              "repository",
              "configuration",
              "deployment",
              "runtime",
              "consumer"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 3
          },
          "readOnly": {
            "const": true
          }
        }
      }
    },
    "directions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fromLanguage",
          "toLanguage",
          "required",
          "mapping"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/kebab"
          },
          "fromLanguage": {
            "$ref": "#/$defs/kebab"
          },
          "toLanguage": {
            "$ref": "#/$defs/kebab"
          },
          "required": {
            "type": "boolean"
          },
          "mapping": {
            "$ref": "#/$defs/mappingSource"
          },
          "parityFields": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "parityDatasets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/parityDataset"
            }
          },
          "outputContracts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/outputContract"
            }
          },
          "derivationOverrides": {
            "type": "array",
            "minItems": 1,
            "description": "Output-contract fields this profile intentionally declares instead of deriving from the registration and language definitions; check-profile accepts a difference only for these (dataset, field) pairs.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dataset",
                "field",
                "reason"
              ],
              "properties": {
                "dataset": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/datasetName"
                    },
                    {
                      "const": "*"
                    }
                  ]
                },
                "field": {
                  "enum": [
                    "expectedOutputDatasets",
                    "requiredInputs",
                    "format",
                    "columnSource",
                    "columns",
                    "key"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 10
                }
              }
            }
          }
        }
      }
    },
    "lexiconModelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateLexiconDiff",
        "path",
        "modelAdditions"
      ],
      "properties": {
        "candidateLexiconDiff": {
          "enum": [
            "forbidden",
            "allowed"
          ]
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "modelAdditions": {
          "enum": [
            "forbidden",
            "allowed"
          ]
        },
        "approvedAdditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "concept",
              "property",
              "approval"
            ],
            "properties": {
              "concept": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "property": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "approval": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        }
      }
    },
    "roundTripStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description",
        "sourceLanguage",
        "steps",
        "comparison",
        "comparisonScope",
        "rowKeys",
        "normalization",
        "permittedLosses"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source-sample-reprojection",
            "forward-inverse"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "sourceLanguage": {
          "$ref": "#/$defs/kebab"
        },
        "steps": {
          "$ref": "#/$defs/kebabList"
        },
        "comparison": {
          "const": "column-diff"
        },
        "comparisonScope": {
          "enum": [
            "inverse-outputs",
            "all-forward-inputs"
          ]
        },
        "rowKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dataset",
              "columns"
            ],
            "properties": {
              "dataset": {
                "$ref": "#/$defs/datasetName"
              },
              "columns": {
                "$ref": "#/$defs/nonEmptyStringList"
              }
            }
          }
        },
        "normalization": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "permittedLosses": {
          "$ref": "#/$defs/stringList"
        },
        "tbd": {
          "$ref": "#/$defs/nonEmptyStringList"
        }
      }
    },
    "partialInputPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "mechanism",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "supported",
            "unsupported",
            "unverified"
          ]
        },
        "mechanism": {
          "type": "string",
          "minLength": 10
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "commitSha",
              "path"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "commitSha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "path": {
                "$ref": "#/$defs/repositoryPath"
              }
            }
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "outputDatasets",
              "providedInputs",
              "expected"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/kebab"
              },
              "outputDatasets": {
                "$ref": "#/$defs/datasetNameList"
              },
              "providedInputs": {
                "$ref": "#/$defs/datasetNameList"
              },
              "expected": {
                "enum": [
                  "PASS",
                  "REJECTED"
                ]
              }
            }
          },
          "description": "Optional extra cases; spec-from-intent already derives one positive case per output and one REJECTED case per required input."
        }
      }
    },
    "validationWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "persistPolicy"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "id",
              "direction",
              "inputSource"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "id": {
                "$ref": "#/$defs/kebab"
              },
              "direction": {
                "$ref": "#/$defs/kebab"
              },
              "inputSource": {
                "enum": [
                  "profile-evidence",
                  "previous-step-output",
                  "existing-dev-artifact"
                ]
              }
            }
          }
        },
        "persistPolicy": {
          "enum": [
            "required",
            "forbidden"
          ]
        }
      }
    },
    "validationSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "location",
              "region",
              "artifactStatus",
              "appliesTo",
              "required"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/kebab"
              },
              "kind": {
                "const": "existing-dev-artifact"
              },
              "location": {
                "type": "string",
                "pattern": "^s3://[^?#@]+/$"
              },
              "region": {
                "type": "string",
                "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"
              },
              "artifactStatus": {
                "enum": [
                  "planned",
                  "staging",
                  "ready"
                ]
              },
              "manifestFileSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "manifestVersionId": {
                "type": "string",
                "minLength": 1
              },
              "appliesTo": {
                "$ref": "#/$defs/kebabList"
              },
              "required": {
                "const": true
              },
              "tbd": {
                "$ref": "#/$defs/nonEmptyStringList"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "artifactStatus": {
                      "const": "ready"
                    }
                  },
                  "required": [
                    "artifactStatus"
                  ]
                },
                "then": {
                  "required": [
                    "manifestFileSha256",
                    "manifestVersionId"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "artifactStatus": {
                      "const": "planned"
                    }
                  },
                  "required": [
                    "artifactStatus"
                  ]
                },
                "then": {
                  "required": [
                    "tbd"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "manifestFileSha256"
                        ]
                      },
                      {
                        "required": [
                          "manifestVersionId"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "repository",
              "path",
              "appliesTo",
              "required"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/kebab"
              },
              "kind": {
                "const": "repository-test"
              },
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "path": {
                "$ref": "#/$defs/repositoryPath"
              },
              "appliesTo": {
                "$ref": "#/$defs/kebabList"
              },
              "required": {
                "const": true
              }
            },
            "description": "A repository test whose result is read from the pinned commit's CI run (read-only); Silvally never runs it locally."
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "location",
              "manifestFileSha256",
              "appliesTo",
              "required"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/kebab"
              },
              "kind": {
                "const": "sanitized-evidence-package"
              },
              "location": {
                "type": "string",
                "pattern": "^s3://[^?#@]+/$"
              },
              "manifestFileSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "manifestVersionId": {
                "type": "string",
                "minLength": 1
              },
              "appliesTo": {
                "$ref": "#/$defs/kebabList"
              },
              "required": {
                "const": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "reason",
              "owner",
              "appliesTo",
              "required"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/kebab"
              },
              "kind": {
                "const": "not-available"
              },
              "reason": {
                "type": "string",
                "minLength": 10
              },
              "owner": {
                "$ref": "#/$defs/kebab"
              },
              "appliesTo": {
                "$ref": "#/$defs/kebabList"
              },
              "required": {
                "const": true
              }
            }
          }
        ]
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensitivity",
        "sanitization",
        "allowed",
        "prohibited"
      ],
      "properties": {
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "sanitization": {
          "const": "aggregates-and-digests-only"
        },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "counts",
              "schemas",
              "sha256",
              "statuses",
              "durations",
              "costs",
              "credential-free-locations"
            ]
          }
        },
        "prohibited": {
          "type": "array",
          "minItems": 4,
          "items": {
            "enum": [
              "raw-pii",
              "business-identifiers",
              "secret-values",
              "credentials",
              "signed-urls",
              "source-rows"
            ]
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "identityRules",
        "endpointRules"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "identityRules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "endpointRules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "adapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boundary"
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/boundary"
      }
    },
    "lexiconConceptPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentDefinitionRequired",
        "rejectAbsent",
        "rejectDeprecated",
        "reintroductionRequiresModelingApproval",
        "forbiddenConcepts"
      ],
      "properties": {
        "currentDefinitionRequired": {
          "const": true
        },
        "rejectAbsent": {
          "const": true
        },
        "rejectDeprecated": {
          "const": true
        },
        "reintroductionRequiresModelingApproval": {
          "const": true
        },
        "forbiddenConcepts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/datasetName"
          }
        }
      }
    },
    "parityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldSource",
        "declaredFields",
        "undefinedDatasets"
      ],
      "properties": {
        "fieldSource": {
          "const": "language-definition-and-registration"
        },
        "declaredFields": {
          "enum": [
            "minimum",
            "exact"
          ]
        },
        "undefinedDatasets": {
          "enum": [
            "block",
            "consumer-contract"
          ]
        }
      }
    },
    "sourceWindowPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "minimumCompleteUtcDays",
        "allowLongerRange",
        "requiredSourceFamilies",
        "requiredCoverageSignals",
        "origin",
        "recordedDefaults",
        "evidenceIds"
      ],
      "properties": {
        "kind": {
          "const": "prod-derived-complete-utc-days"
        },
        "origin": {
          "enum": [
            "profile-declared",
            "derived-at-intake"
          ]
        },
        "recordedDefaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimumCompleteUtcDays": {
              "type": "integer",
              "minimum": 1
            },
            "allowLongerRange": {
              "type": "boolean"
            }
          }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kebab"
          }
        },
        "minimumCompleteUtcDays": {
          "type": "integer",
          "minimum": 1
        },
        "allowLongerRange": {
          "type": "boolean"
        },
        "requiredSourceFamilies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/datasetName"
          }
        },
        "requiredCoverageSignals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kebab"
          }
        },
        "selection": {
          "enum": [
            "user-confirmed",
            "most-recent-full-utc-day-with-data-per-slice"
          ],
          "description": "user-confirmed (default) asks the user to confirm the recommended window; the per-slice form applies only when the owner chose it up front."
        }
      }
    },
    "scaleTiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "maximumRows",
          "maximumCostUsd",
          "evidenceRequired"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/kebab"
          },
          "maximumRows": {
            "type": "integer",
            "minimum": 1
          },
          "maximumCostUsd": {
            "type": "number",
            "minimum": 0
          },
          "evidenceRequired": {
            "type": "boolean"
          }
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "devWrites",
        "prodWrites",
        "perOperation"
      ],
      "properties": {
        "devWrites": {
          "const": "explicit"
        },
        "prodWrites": {
          "const": "forbidden"
        },
        "perOperation": {
          "const": true
        }
      }
    },
    "oracles": {
      "type": "array",
      "minItems": 1,
      "description": "Expected-output datasets referenced by matches-oracle checks: PROD actuals already materialized in DEV S3, never locally computed rows.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dataset",
          "location",
          "comparison",
          "description"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/kebab"
          },
          "dataset": {
            "$ref": "#/$defs/datasetName"
          },
          "location": {
            "type": "string",
            "pattern": "^s3://[^?#@]+$"
          },
          "comparison": {
            "enum": [
              "part-bytes",
              "sorted-rows",
              "keyed"
            ]
          },
          "key": {
            "$ref": "#/$defs/nonEmptyStringList"
          },
          "ignoreColumns": {
            "$ref": "#/$defs/nonEmptyStringList"
          },
          "allowedLosses": {
            "$ref": "#/$defs/kebabList"
          },
          "description": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "allowedLosses": {
      "type": "array",
      "minItems": 1,
      "description": "Permitted differences a keyed oracle comparison may explain.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dataset",
          "column",
          "kind",
          "reason"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/kebab"
          },
          "dataset": {
            "$ref": "#/$defs/datasetName"
          },
          "column": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "emptied",
              "any"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "canaryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventsPerSlice",
        "selection",
        "mixOutcomes"
      ],
      "description": "The DEV canary run before the full window: real events from the confirmed window, chosen deterministically.",
      "properties": {
        "eventsPerSlice": {
          "const": 10
        },
        "selection": {
          "const": "outcome-round-robin-by-time-then-key-sha256"
        },
        "mixOutcomes": {
          "type": "boolean"
        }
      }
    },
    "prodActuals": {
      "type": "string",
      "minLength": 1,
      "description": "Id of the package entry in reference/prod-actuals.json whose slices define what PROD actually produced."
    },
    "validationChain": {
      "type": "object",
      "additionalProperties": false,
      "description": "A chained validation of N steps run in order, canary first and then the full window, each step with its own evidence and DEV approval. transform steps pin their own mapping; persist-load and persist-export load the previous transform output into DEV Persist and export exactly this run's elements back; compare checks the final output against the PROD source events. Catalogued chains live in reference/chains.json.",
      "required": [
        "chain",
        "steps"
      ],
      "properties": {
        "chain": {
          "type": "string",
          "minLength": 1,
          "description": "chain id in the chain catalog"
        },
        "catalog": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "id",
              "kind"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "id": {
                "$ref": "#/$defs/kebab"
              },
              "kind": {
                "enum": [
                  "source-events",
                  "transform",
                  "persist-load",
                  "persist-export",
                  "compare"
                ]
              },
              "direction": {
                "$ref": "#/$defs/kebab",
                "description": "the profile direction a transform step executes"
              },
              "inputStep": {
                "$ref": "#/$defs/kebab",
                "description": "the earlier step whose committed output this step reads"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "transform"
                    }
                  }
                },
                "then": {
                  "required": [
                    "direction"
                  ]
                }
              }
            ]
          }
        },
        "persistPolicy": {
          "enum": [
            "required"
          ]
        }
      }
    }
  },
  "$defs": {
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kebabList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/kebab"
      }
    },
    "datasetName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "datasetNameList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/datasetName"
      }
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "mappingSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "id",
            "version",
            "repository",
            "sourcePaths",
            "artifactPath",
            "expectedOutputDatasets"
          ],
          "properties": {
            "status": {
              "const": "registered"
            },
            "id": {
              "$ref": "#/$defs/kebab"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "sourcePaths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/repositoryPath"
              }
            },
            "artifactPath": {
              "$ref": "#/$defs/repositoryPath"
            },
            "generatedArtifact": {
              "$ref": "#/$defs/plannedMappingSource/properties/generatedArtifact"
            },
            "expectedOutputDatasets": {
              "$ref": "#/$defs/datasetNameList"
            },
            "outputDatasetMatch": {
              "$ref": "#/$defs/outputDatasetMatch"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "expectedId",
            "owner",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "not-registered"
            },
            "expectedId": {
              "$ref": "#/$defs/kebab"
            },
            "owner": {
              "$ref": "#/$defs/kebab"
            },
            "reason": {
              "type": "string",
              "minLength": 10
            },
            "plannedSource": {
              "$ref": "#/$defs/plannedMappingSource"
            }
          }
        }
      ]
    },
    "parityDataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "fields"
      ],
      "properties": {
        "dataset": {
          "$ref": "#/$defs/datasetName"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "plannedMappingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sourcePaths",
        "generatedArtifact",
        "expectedOutputDatasets"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "sourcePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "generatedArtifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generatorPath",
            "logicalArtifactPath",
            "materializationCommand"
          ],
          "properties": {
            "generatorPath": {
              "$ref": "#/$defs/repositoryPath"
            },
            "logicalArtifactPath": {
              "$ref": "#/$defs/repositoryPath"
            },
            "materializationCommand": {
              "type": "string",
              "minLength": 3
            }
          }
        },
        "expectedOutputDatasets": {
          "$ref": "#/$defs/datasetNameList"
        },
        "outputDatasetMatch": {
          "$ref": "#/$defs/outputDatasetMatch"
        }
      }
    },
    "outputDatasetMatch": {
      "description": "exact: registered outputs equal expectedOutputDatasets; includes: registered outputs contain them (a profile that consumes a subset of a large generated mapping)",
      "enum": [
        "exact",
        "includes"
      ]
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "requiredInputs",
        "format",
        "columnSource",
        "columns",
        "status"
      ],
      "properties": {
        "dataset": {
          "$ref": "#/$defs/datasetName"
        },
        "requiredInputs": {
          "$ref": "#/$defs/datasetNameList"
        },
        "format": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "csv",
                "jsonl",
                "parquet",
                "xlsx"
              ]
            },
            "delimiter": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            },
            "header": {
              "type": "boolean"
            }
          },
          "if": {
            "properties": {
              "type": {
                "const": "csv"
              }
            }
          },
          "then": {
            "required": [
              "type",
              "delimiter",
              "header"
            ]
          }
        },
        "columnSource": {
          "enum": [
            "language-definition",
            "language-definition-subset",
            "consumer-contract"
          ]
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "columnConstraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "column"
            ],
            "properties": {
              "column": {
                "type": "string",
                "minLength": 1
              },
              "const": {
                "type": "string"
              },
              "enum": {
                "$ref": "#/$defs/nonEmptyStringList"
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "nonEmpty": {
                "const": true
              }
            },
            "oneOf": [
              {
                "required": [
                  "const"
                ]
              },
              {
                "required": [
                  "enum"
                ]
              },
              {
                "required": [
                  "pattern"
                ]
              },
              {
                "required": [
                  "nonEmpty"
                ]
              }
            ]
          }
        },
        "status": {
          "enum": [
            "planned",
            "verified"
          ]
        },
        "tbd": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "key": {
          "$ref": "#/$defs/nonEmptyStringList"
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "required",
        "schemaSource"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/datasetName"
        },
        "role": {
          "enum": [
            "source",
            "target",
            "intermediate",
            "readback"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "schemaSource": {
          "enum": [
            "lexicon-language-definition",
            "consumer-contract"
          ]
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "phase",
        "failureCode"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebab"
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "phase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "failureCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]+$"
        },
        "check": {
          "$ref": "#/$defs/declarativeCheck"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "owner",
        "contract"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/kebab"
        },
        "owner": {
          "$ref": "#/$defs/kebab"
        },
        "contract": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "declarativeCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "dataset"
      ],
      "description": "A mapping-neutral check interpreted by compare_datasets.py check; domain meaning lives only in the values.",
      "properties": {
        "kind": {
          "enum": [
            "column-constraint",
            "unique-key",
            "row-count",
            "columns-exact",
            "matches-oracle"
          ]
        },
        "dataset": {
          "$ref": "#/$defs/datasetName"
        },
        "column": {
          "type": "string",
          "minLength": 1
        },
        "const": {
          "type": "string"
        },
        "enum": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "nonEmpty": {
          "const": true
        },
        "key": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "columns": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "equals": {
          "type": "integer",
          "minimum": 0
        },
        "oracle": {
          "$ref": "#/$defs/kebab"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "column-constraint"
              }
            }
          },
          "then": {
            "required": [
              "column"
            ],
            "oneOf": [
              {
                "required": [
                  "const"
                ]
              },
              {
                "required": [
                  "enum"
                ]
              },
              {
                "required": [
                  "pattern"
                ]
              },
              {
                "required": [
                  "nonEmpty"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unique-key"
              }
            }
          },
          "then": {
            "required": [
              "key"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "matches-oracle"
              }
            }
          },
          "then": {
            "required": [
              "oracle"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "row-count"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "min"
                ]
              },
              {
                "required": [
                  "max"
                ]
              },
              {
                "required": [
                  "equals"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
