{
  "version": "3",
  "flow_name": "partner-file-delivery",
  "kind": "flow",
  "description": "Deliver files the caller already produced (S3 file pointers) to a partner outbox on SFTP, Azure Blob or S3. Used for DSA results and seller reporting uploads.",
  "connections": {
    "outbox": { "types": ["sftp", "azure_blob", "s3"] }
  },
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": ["files"],
    "properties": {
      "files": {
        "type": "array", "minItems": 1, "maxItems": 1000,
        "items": {
          "type": "object", "required": ["file", "path"],
          "properties": { "file": { "type": "object" }, "path": { "type": "string" } }
        }
      }
    }
  },
  "triggers": ["api"],
  "limits": { "timeout_seconds": 3600, "max_items": 1000, "max_bytes": 21474836480 },
  "definition": {
    "StartAt": "PerFile",
    "States": {
      "PerFile": {
        "Type": "Map",
        "Items": "$.request.files",
        "Concurrency": 10,
        "Iterator": {
          "StartAt": "Deliver",
          "States": {
            "Deliver": {
              "Type": "Task",
              "ResourceDefinition": {
                "Type": "PUT",
                "Connection": "outbox",
                "From": "$.item.file",
                "Path": "$.item.path",
                "Overwrite": "if_changed",
                "Runner": "auto",
                "SaveOutputTo": "$.vars.delivered"
              },
              "End": true
            }
          }
        },
        "End": true
      }
    }
  }
}
